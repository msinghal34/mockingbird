# Copy to .env.local and fill in. Never commit the filled-in file.

# Postgres. Provisioned through the Vercel Marketplace with `vercel install neon`,
# which writes this into the project's environment for you. Any Postgres URL works.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google AI Studio, free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# twitterapi.io, pay-as-you-go: https://twitterapi.io
# Without this the app still runs, but only for the handles with a committed
# fixture in src/lib/x/fixtures/ — everything else reports that it can't fetch.
TWITTERAPI_IO_KEY=
